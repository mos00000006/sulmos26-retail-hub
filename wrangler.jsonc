{
  "name": "sulmos26-retail-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "sulmos26-db", "database_id": "REPLACE_WITH_YOUR_NEW_D1_DATABASE_ID", "migrations_dir": "./migrations" }]
}
